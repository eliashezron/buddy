# Copy to .env and fill in. Every variable without a default is required:
# the api and worker refuse to boot and list whatever is missing.

# --- Infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgres://wa:wa@localhost:5432/wa
REDIS_URL=redis://localhost:6379

# --- WhatsApp Cloud API (see docs/whatsapp-notes.md §2–3) ---
# Pin the Graph API version and upgrade deliberately. Confirm the current
# version before going live (whatsapp-notes.md §12).
GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
# System-user permanent token. Never the 24-hour dev token in production.
WHATSAPP_ACCESS_TOKEN=
# App Secret, used to verify X-Hub-Signature-256 on every webhook POST.
WHATSAPP_APP_SECRET=
# Any string you choose; must match what you enter in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# Optional. Used by `pnpm replay` to fill WABA_ID_PLACEHOLDER.
WHATSAPP_WABA_ID=

# --- Model vendor (must be on zero-retention / no-training terms) ---
ANTHROPIC_API_KEY=
# Optional overrides.
# AGENT_MODEL=claude-opus-5
# SEARCH_MODEL=claude-sonnet-5

# --- Optional ---
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=info
# DEFAULT_TIMEZONE=Africa/Kampala
# MESSAGE_RETENTION_DAYS=30
