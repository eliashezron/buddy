# Copy to .env and fill in. Every variable without a default is required:
# the api and worker refuse to boot and list whatever is missing.

# --- Infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgres://wa:wa@localhost:5432/wa
REDIS_URL=redis://localhost:6379

# --- WhatsApp Cloud API (see docs/whatsapp-notes.md §2–3) ---
# Pin the Graph API version and upgrade deliberately. Confirm the current
# version before going live (whatsapp-notes.md §12).
GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
# System-user permanent token. Never the 24-hour dev token in production.
WHATSAPP_ACCESS_TOKEN=
# App Secret, used to verify X-Hub-Signature-256 on every webhook POST.
WHATSAPP_APP_SECRET=
# Any string you choose; must match what you enter in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# Optional. Used by `pnpm replay` to fill WABA_ID_PLACEHOLDER.
WHATSAPP_WABA_ID=
# --- Telegram (optional; see docs/telegram-notes.md) ---
# Setting the token turns the Telegram channel on. Create a bot with @BotFather.
# Locally, use a separate dev bot from the one in production.
# TELEGRAM_BOT_TOKEN=
# Required in webhook mode. Generate with: openssl rand -hex 32
# TELEGRAM_WEBHOOK_SECRET=
# webhook (production) or polling (local dev: no tunnel needed).
# TELEGRAM_MODE=polling
# Polling refuses to start while the bot has a webhook registered (e.g. production
# on Render). true takes the bot over anyway, disconnecting that deployment.
# TELEGRAM_POLLING_TAKEOVER=false
# Public https URL of the api. In webhook mode the api registers the Telegram webhook
# on boot. On Render this comes from RENDER_EXTERNAL_URL automatically.
# PUBLIC_BASE_URL=https://example.com

# --- Google connectors: Calendar + Gmail (optional; see docs/connectors.md) ---
# Setting the client id turns the connectors on; access is asked for per request.
# OAuth client (type: Web application) from Google Cloud console. Authorised redirect
# URI must be exactly <PUBLIC_BASE_URL>/oauth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Encrypts OAuth tokens at rest. Generate with: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=

# --- Model vendor (must be on zero-retention / no-training terms) ---
ANTHROPIC_API_KEY=
# Optional overrides.
# AGENT_MODEL=claude-opus-5
# Development only: run the agent on a cheap OpenAI-style model through OpenCode Zen.
# Refused when NODE_ENV=production (CLAUDE.md: zero-retention model vendors only).
# Web search still uses ANTHROPIC_API_KEY.
# LLM_PROVIDER=opencode
# OPENCODE_API_KEY=
# AGENT_MODEL=gpt-6-luna
# OPENCODE_BASE_URL=https://opencode.ai/zen
# SEARCH_MODEL=claude-sonnet-5

# --- Optional ---
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=info
# DEFAULT_TIMEZONE=Africa/Kampala
# MESSAGE_RETENTION_DAYS=30