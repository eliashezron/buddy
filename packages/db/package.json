{
  "name": "@wa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/migrate.ts"
  },
  "dependencies": { "@wa/core": "workspace:*", "drizzle-orm": "^0.45.3", "postgres": "^3.4.9" },
  "devDependencies": { "drizzle-kit": "^0.31.11" }
}
